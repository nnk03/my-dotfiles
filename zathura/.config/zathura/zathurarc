# include "./themes/catppuccin-mocha"

# --- Clipboard & System Integration ---
set selection-clipboard clipboard  # Auto-copy text selections to system clipboard

# --- UI Tweaks ---
# set statusbar-h-padding 10
# set statusbar-v-padding 10

# --- Search & Behavior ---
set search-hadjust true # so that search results appear in the centre of the page
# set adjust-open "width"            # Fit page width on open

# --- Recolor / Dark Mode Settings ---
set recolor false                  # Set true to start in dark mode
set recolor-keephue true           # Preserve original image/photo colors
# set recolor-lightcolor "#1e1e2e"   # Dark background
# set recolor-darkcolor "#cdd6f4"    # Light text

# --- Custom Keybindings ---
# map u scroll half-up
# map d scroll half-down

# Define dark mode colors (Catppuccin Macchiato style)
set recolor-lightcolor "#1e1e2e"    # Background
set recolor-darkcolor  "#cdd6f4"    # Text

