layout {
    background-color "transparent"

    focus-ring {
        active-color   "#ccbeff"
        inactive-color "#938f99"
        urgent-color   "#ffb4ab"
    }

    border {
        active-color   "#ccbeff"
        inactive-color "#938f99"
        urgent-color   "#ffb4ab"
    }

    shadow {
        color "#00000070"
    }

    tab-indicator {
        active-color   "#ccbeff"
        inactive-color "#938f99"
        urgent-color   "#ffb4ab"
    }

    insert-hint {
        color "#ccbeff80"
    }
}

/-recent-windows {
    highlight {
        active-color   "#4a3e76"
        urgent-color   "#ffb4ab"
    }
}